# PostgreSQL (used by the db service and the API)
POSTGRES_USER=sraya
POSTGRES_PASSWORD=sraya
POSTGRES_DB=sraya
DB_HOST=db
DB_PORT=5432

# Host ports mapped into the containers
API_PORT=8080
WEB_PORT=5173

# Auth
# HMAC secret used to sign JWTs. CHANGE THIS in any non-local environment.
JWT_SECRET=change-me-in-production
# Initial admin account created on first boot when the DB has no users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Origin allowed to send credentialed (cookie) requests to the API.
WEB_ORIGIN=http://localhost:5173
# Set to true when serving the API over HTTPS (marks the cookie Secure).
COOKIE_SECURE=false
